# Foundation only: do not enable purchases before the release checklist is complete.
STRIPE_BILLING_ENABLED=false
STRIPE_CHECKOUT_ENABLED=false
STRIPE_BILLING_MODE=test

# Server-only values. Never use NEXT_PUBLIC_ and never commit real credentials.
# Prefer a restricted API key (rk_test_ / rk_live_) with only required permissions.
STRIPE_SECRET_KEY=
STRIPE_ACCOUNT_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_WEBHOOK_SECRET=
STRIPE_RECONCILIATION_SECRET=

# Reuse the existing Supabase server configuration:
# SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY
# NEXT_PUBLIC_SUPABASE_URL
# NEXT_PUBLIC_SITE_URL

# Test mode: NODE_ENV=development and BOTH application/database on loopback.
# Live mode: NODE_ENV=production, HTTPS database and https://yokkai-collec.com.
# Never configure live credentials in a local environment.

# Sandbox Price and Account IDs verified via the read-only Stripe preflight.
# Use only with credentials and Account ID from that same Sandbox.
# STRIPE_PRO_PRICE_ID=price_1URcyIIQHbfFctSIkiBvXgIo
# STRIPE_ACCOUNT_ID=acct_1UQSisIQHbfFctSI

# Owner-supplied production Price ID (not verified against Stripe yet).
# Do not use this live price in the test configuration above.
# STRIPE_PRO_PRICE_ID=price_1URdBZIuXkg5OZqmJiQZmOr7
# STRIPE_ACCOUNT_ID=acct_1UQSidIuXkg5OZqm

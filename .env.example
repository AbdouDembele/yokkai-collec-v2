# Copier ce fichier vers .env.local et renseigner les valeurs du projet Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Stable binder client contract. Keep false until the isolated migration and UI
# review pass; production activation requires the owner's explicit approval.
NEXT_PUBLIC_STABLE_BINDERS_ENABLED=false
# EN/FR UI stays disabled until PRs 1 and 2 are merged and reviewed.
NEXT_PUBLIC_I18N_ENABLED=false
# Only enable after verifying Cloudflare is the sole trusted path to the origin.
I18N_TRUST_CF_COUNTRY=false
# Origine de l'application pour les emails de confirmation (URL de production au déploiement).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
# Clé publique d’une application Web GIPHY pour le sélecteur du chat.
NEXT_PUBLIC_GIPHY_API_KEY=
# Optionnel, serveur : clé GIPHY de la vérification du rating des GIF (#379).
# À défaut, la route utilise NEXT_PUBLIC_GIPHY_API_KEY.
GIPHY_API_KEY=

# Public Discord invitation used by the server-side /discord redirect.
DISCORD_INVITE_URL=

# Interrompt globalement toutes les routes applicatives avec une page statique 503.
MAINTENANCE_MODE=false

# Import et suppression de compte : clé serveur, jamais préfixée NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Alternative legacy à SUPABASE_SECRET_KEY :
# SUPABASE_SERVICE_ROLE_KEY=
